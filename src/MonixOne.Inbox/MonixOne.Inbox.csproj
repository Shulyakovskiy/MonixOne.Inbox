<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>MonixOne.Inbox</Title>
    <Description>Ordered inbox for .NET 10, EF Core, PostgreSQL and NATS JetStream with transactional handlers, per-key ordering, deduplication, retries and dead-letter storage.</Description>
    <Version>1.1.1</Version>
    <IsPackable>true</IsPackable>
    <PackageId>MonixOne.Inbox</PackageId>
    <Authors>Shulyakovsky.E</Authors>
    <Copyright>Copyright (c) 2026 Shulyakovskiy Evgeniy</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Shulyakovskiy/MonixOne.Inbox</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shulyakovskiy/MonixOne.Inbox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>dotnet;inbox;PostgreSQL;NATS;JetStream;EFCore;ordered;idempotency;retry;DLQ</PackageTags>
    <PackageReleaseNotes>Add the package icon, MIT license metadata, project and source repository links.</PackageReleaseNotes>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <_InboxPackageReadmePath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/nuget/README.md</_InboxPackageReadmePath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="linq2db.EntityFrameworkCore" />
    <PackageReference Include="linq2db" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="NATS.Client.JetStream" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MonixOne.Inbox.Tests" />
    <EmbeddedResource Include="Migrations/*.sql" />
    <Content Include="Migrations/*.sql" Pack="true" PackagePath="tools/migrations" />
    <None Include="../../README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../assets/nuget-icon.png" Link="nuget-icon.png" Pack="true" PackagePath="/" />
    <None Include="$(_InboxPackageReadmePath)" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../docs/event-processing.png" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/event-processing.svg" Pack="true" PackagePath="docs/" />
  </ItemGroup>
  <!-- NuGet.org требует абсолютные URL изображений; локальный README сохраняет относительные ссылки. -->
  <UsingTask TaskName="WriteInboxPackageReadme" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <DestinationFile ParameterType="System.String" Required="true" />
      <ImageBaseUrl ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // File IO preserves backslashes in JSON examples; MSBuild item values may normalize them as paths.
        var content = File.ReadAllText(SourceFile)
            .Replace("(docs/event-processing.png)", "(" + ImageBaseUrl + "event-processing.png)")
            .Replace("(docs/event-processing.svg)", "(" + ImageBaseUrl + "event-processing.svg)");
        var destination = Path.GetFullPath(DestinationFile);
        Directory.CreateDirectory(Path.GetDirectoryName(destination));
        if (!File.Exists(destination) || File.ReadAllText(destination) != content)
            File.WriteAllText(destination, content, new System.Text.UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="PrepareInboxPackageReadme" BeforeTargets="_GetPackageFiles">
    <WriteInboxPackageReadme SourceFile="$(MSBuildThisFileDirectory)../../README.md"
                             DestinationFile="$(_InboxPackageReadmePath)"
                             ImageBaseUrl="https://raw.githubusercontent.com/Shulyakovskiy/MonixOne.Inbox/main/docs/" />
  </Target>
</Project>
