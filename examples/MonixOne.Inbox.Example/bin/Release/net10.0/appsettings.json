{
  "ConnectionStrings": {
    "Application": "Host=127.0.0.1;Port=5432;Database=inbox_example;Username=app;Password=app"
  },
  "Nats": {
    "Url": "nats://127.0.0.1:4222",
    "Username": "admin",
    "Password": "admin"
  },
  "OrderedInbox": {
    "Handlers": {
      "locations": {
        "Subscriptions": {
          "locations-events": {
            "Stream": "HUB_EVENTS",
            "Subject": "hub.connect.>",
            "DurableName": "example-locations"
          }
        }
      }
    },
    "Defaults": {
      "StartupReorderWindow": "00:00:01",
      "GapTimeout": "00:00:05",
      "MaxParallelObjects": 4,
      "IntakeConcurrency": 4
    }
  }
}
